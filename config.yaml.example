# Kopie nach config.yaml und anpassen (nur Abweichungen vom Standard noetig; Standard: df_llm_helper/config.py DEFAULTS).
# Copy to config.yaml and adjust (only values that differ from df_llm_helper/config.py DEFAULTS).
dfhack_run: 'C:\Program Files (x86)\Steam\steamapps\common\Dwarf Fortress\hack\dfhack-run.exe'
# Shared runtime folder: set the environment variable DF_LLM_HELPER_HOME (system-wide, so Dwarf Fortress sees it too) to
# e.g. C:\df-llm-helper\runtime. df-llm-helper uses <DF_LLM_HELPER_HOME>/tools, the Lua scripts use the same folder (util.home()).
paths:
  gamelog: 'C:\Program Files (x86)\Steam\steamapps\common\Dwarf Fortress\gamelog.txt'
# Festungsspezifisch (Beispielwerte aus Run 5 "Windrings" - fuer die eigene Karte ersetzen):
siege: {squad_alias: Wache, rally: null}
water:
  fort_box: [60, 40, 126, 127, 130, 133]
  forbid_dig: []
  chokepoints: []
# wake: gamelog rules (alarms, deaths/tantrums/moods, caravan, ghosts); all optional
wake:
  gamelog_rules:
    enabled: true
    rules: {}            # e.g. {ghost: {cooldown_s: 1800}, alarm_hard: {enabled: false}}
    extra: []            # e.g. [{name: plague, pattern: 'plague', next: 'look at it', cooldown_s: 600}]
